rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Connectivity Diagnostic Endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // 3. Helper Security Functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Validation Schema for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!data.keys().contains('displayName') || (data.displayName is string && data.displayName.size() <= 200)) &&
             (!data.keys().contains('affiliation') || (data.affiliation is string && data.affiliation.size() <= 300)) &&
             (!data.keys().contains('createdAt') || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Validation Schema for EngineConfig
    function isValidEngineConfig(data) {
       return data.keys().hasAll(['userId', 'name', 'configData', 'createdAt', 'updatedAt']) &&
              data.userId is string && data.userId == request.auth.uid &&
              data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
              data.configData is string && data.configData.size() <= 100000 &&
              data.createdAt is timestamp &&
              data.updatedAt is timestamp;
    }

    // Validation Schema for BraggHistoryItem
    function isValidBraggHistoryItem(data) {
       return data.keys().hasAll(['id', 'userId', 'timestamp', 'wavelength', 'rawPeaks', 'rawHKL', 'resultsJson']) &&
              data.id is string && data.id.size() <= 128 &&
              data.userId is string && data.userId == request.auth.uid &&
              data.timestamp is string && data.timestamp.size() <= 100 &&
              data.wavelength is number && data.wavelength > 0 && data.wavelength < 100 &&
              data.rawPeaks is string && data.rawPeaks.size() <= 10000 &&
              data.rawHKL is string && data.rawHKL.size() <= 10000 &&
              data.resultsJson is string && data.resultsJson.size() <= 200000 &&
              (!data.keys().contains('sampleId') || (data.sampleId is string && data.sampleId.size() <= 100));
    }

    // Validation Schema for CustomMaterial
    function isValidCustomMaterial(data) {
       return data.keys().hasAll(['id', 'userId', 'name', 'formula', 'pattern']) &&
              data.id is string && data.id.size() <= 128 &&
              data.userId is string && data.userId == request.auth.uid &&
              data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
              data.formula is string && data.formula.size() <= 100 &&
              data.pattern is string && data.pattern.size() <= 200000 &&
              (!data.keys().contains('type') || (data.type is string && data.type.size() <= 200)) &&
              (!data.keys().contains('description') || (data.description is string && data.description.size() <= 2000)) &&
              (!data.keys().contains('crystalSystem') || (data.crystalSystem is string && data.crystalSystem.size() <= 200)) &&
              (!data.keys().contains('spaceGroup') || (data.spaceGroup is string && data.spaceGroup.size() <= 200)) &&
              (!data.keys().contains('density') || (data.density is number)) &&
              (!data.keys().contains('molecularWeight') || (data.molecularWeight is number)) &&
              (!data.keys().contains('elasticModulus') || (data.elasticModulus is number));
    }

    // Validation Schema for UserActivity
    function isValidUserActivity(data) {
       return data.keys().hasAll(['id', 'userId', 'category', 'action', 'timestamp']) &&
              data.id is string && data.id.size() <= 128 &&
              data.userId is string && data.userId == request.auth.uid &&
              data.category is string && data.category.size() <= 64 &&
              data.action is string && data.action.size() <= 300 &&
              data.timestamp is string && data.timestamp.size() <= 100 &&
              (!data.keys().contains('module') || (data.module is string && data.module.size() <= 100)) &&
              (!data.keys().contains('details') || (data.details is string && data.details.size() <= 20000)) &&
              (!data.keys().contains('userName') || (data.userName is string && data.userName.size() <= 200)) &&
              (!data.keys().contains('userEmail') || (data.userEmail is string && data.userEmail.size() <= 256));
    }

    // Collection Security Rules

    // 1. /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming()) && incoming().uid == existing().uid && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'affiliation', 'createdAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId;
      allow list: if false; 
    }

    // 2. /engineConfigs/{configId}
    match /engineConfigs/{configId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(configId) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(configId) && isValidEngineConfig(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(configId) && existing().userId == request.auth.uid && isValidEngineConfig(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'configData', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(configId) && existing().userId == request.auth.uid;
    }

    // 3. /braggHistory/{historyId}
    match /braggHistory/{historyId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(historyId) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(historyId) && isValidBraggHistoryItem(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(historyId) && existing().userId == request.auth.uid;
    }

    // 4. /customMaterials/{materialId}
    match /customMaterials/{materialId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(materialId) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(materialId) && isValidCustomMaterial(incoming());
      allow update: if isSignedIn() && isValidId(materialId) && existing().userId == request.auth.uid && isValidCustomMaterial(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(materialId) && existing().userId == request.auth.uid;
    }

    // 5. /userActivities/{activityId}
    match /userActivities/{activityId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(activityId) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(activityId) && isValidUserActivity(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(activityId) && existing().userId == request.auth.uid;
    }
  }
}
